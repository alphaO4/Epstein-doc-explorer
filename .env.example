# LLM Configuration for Analysis Pipeline
# ========================================

# Provider options: 'local' | 'openrouter' | 'openai' | 'anthropic'
# Default: 'local'
LLM_PROVIDER=local

# Base URL for the API endpoint
# Default for local (Ollama): http://localhost:11434/v1
# OpenRouter: https://openrouter.ai/api/v1
# OpenAI: https://api.openai.com/v1
# Anthropic: https://api.anthropic.com/v1
LLM_BASE_URL=http://localhost:11434/v1

# Model name (provider-specific)
# Local (Ollama): llama3.2, mistral, mixtral, etc.
# OpenRouter: meta-llama/llama-3.1-8b-instruct, anthropic/claude-3.5-haiku, etc.
# OpenAI: gpt-4o-mini, gpt-4-turbo, etc.
# Anthropic: claude-3-5-haiku-latest, claude-3-5-sonnet-latest, etc.
LLM_MODEL=llama3.2

# API Key (not needed for most local endpoints)
# LLM_API_KEY=your-api-key-here

# Optional: Max tokens for responses (default: 16000)
# LLM_MAX_TOKENS=16000

# Optional: Temperature for generation (default: 0.1)
# LLM_TEMPERATURE=0.1

# ========================================
# API Server Configuration
# ========================================

# Server port (default: 3001)
# PORT=3001

# Database path (default: document_analysis.db)
# DB_PATH=document_analysis.db

# Allowed CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================================
# Frontend Configuration
# ========================================

# API base URL override for frontend (usually not needed)
# VITE_API_BASE_URL=http://localhost:3001/api
